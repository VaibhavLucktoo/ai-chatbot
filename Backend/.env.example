APP_NAME="AI Chatbot"
APP_ENV=development

# Local API connection to the PostgreSQL service in compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=5433
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot_admin
POSTGRES_PASSWORD=your_password_here

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_THREADS=2

# MVP evidence gate: call the LLM if any retrieved chunk is within this cosine
# distance, OR the candidate set matches at least two distinct English query
# lexemes (one for a single-lexeme query). PostgreSQL removes stop words/stems.
# This heuristic needs corpus-specific evaluation; it does not prove support.
# All retrieved chunks keep their RRF order when the gate passes.
RAG_MAX_COSINE_DISTANCE=0.45

# Local Llama through Ollama; no API key or paid account required.
# Install Ollama, then run: ollama pull llama3.2:1b-instruct-q4_K_M
# The small model is intended for initial development on limited RAM.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2:1b-instruct-q4_K_M
LLM_TIMEOUT_SECONDS=120
LLM_API_KEY=

# Per-assistant provider keys are encrypted separately from PostgreSQL.
# Optional Fernet master key. If empty, the local admin module creates a key file
# at ../.cache/assistant-secrets/connection.key when saving the first connection.
# Keep that file private and back it up separately; losing it makes saved keys unusable.
ASSISTANT_ENCRYPTION_KEY=

# Limits for the trusted local workspace. Set the context window to your model.
RAG_MAX_CONTEXT_CHUNKS=5
RAG_REVIEW_MULTIPART_ANSWERS=true
RAG_MAX_PROMPT_BYTES=24000
RAG_CONTEXT_WINDOW_TOKENS=32768
RAG_OUTPUT_RESERVE_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=300
LLM_MAX_INPUT_BYTES=64000
LLM_TEMPERATURE=0
CHAT_TIMEOUT_SECONDS=180
# Opt-in conversational memory: complete turns, bounded UTF-8 bytes, inactivity TTL.
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_TURNS=6
CONVERSATION_MAX_HISTORY_BYTES=12000
# Content-free analytics. Pricing stays unavailable until exact model rates are supplied.
METRICS_QUEUE_CAPACITY=1000
METRICS_WRITE_TIMEOUT_SECONDS=2
METRICS_MODEL_PRICES={}
# Process-local assistant snapshots; 0 disables caching. Revisions are checked in PostgreSQL.
ASSISTANT_CACHE_TTL_SECONDS=300
ASSISTANT_CACHE_MAX_ENTRIES=128
# JSON example (replace placeholders with verified USD rates per million tokens):
# METRICS_MODEL_PRICES={"your-model":{"input_usd_per_million":0.10,"output_usd_per_million":0.20}}
INGESTION_TIMEOUT_SECONDS=600
PDF_PARSE_TIMEOUT_SECONDS=30
PDF_PARSE_MEMORY_MB=512
INGESTION_LEASE_SECONDS=120
INGESTION_RECOVERY_INTERVAL_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_WARMUP_ON_STARTUP=true
LOCAL_MAX_ACTIVE_REQUESTS=4

# With more available memory, pull llama3.2:3b and change LLM_MODEL to match.
# Together alternative: https://api.together.ai/v1 with
# meta-llama/Llama-3.3-70B-Instruct-Turbo; requires an API key and account credits.
# For vLLM, use its server's /v1 base and exact served model name.
# Groq uses https://api.groq.com/openai/v1; verify model access before switching.
# Groq's Llama 3.1/3.3 models now require enterprise access.
